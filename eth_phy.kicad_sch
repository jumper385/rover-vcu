	(text_box "DC BLOCK SIZINGS\n\nDC Block should be invisible between the 1-100MHz region; This part acts as a highpass filter; \n\n100nF gives it a 30kHz Cut-off;\n100nF also standard in most datasheets accross TI, NXP and Microchip; "
		(exclude_from_sim no)
		(at 199.39 13.97 0)
		(size 34.29 24.3946)
		(margins 0.9525 0.9525 0.9525 0.9525)
