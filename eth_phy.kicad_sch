			)
			(justify left top)
		)
		(uuid "0d6b4c97-367e-4d81-8883-bf0da952d0bb")
	)
	(text_box "CMC IMPEDANCE SIZING\n\nCMC required for 10-100MHz needs to be <45dBm as per openalliance spec; (FIG B-3 PAGE 26 Opensig CMC Test Specification for 100Base-T1)\n\n20log(Z0/(Z0+2Zcm) > -45dB\nZ_cm > 4.42kOhm"
		(exclude_from_sim no)
		(at 199.39 55.88 0)
